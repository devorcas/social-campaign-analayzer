{
  "Comment": "Campaign analysis orchestration. Replace ARNs before deployment.",
  "StartAt": "ValidateInput",
  "States": {
    "ValidateInput": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<VALIDATE_INPUT_LAMBDA_ARN>",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2.0,
          "MaxAttempts": 2
        }
      ],
      "Next": "IngestContent"
    },
    "IngestContent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<INGEST_CONTENT_LAMBDA_ARN>",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2.0,
          "MaxAttempts": 2
        }
      ],
      "Next": "PrepareMedia"
    },
    "PrepareMedia": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<PREPARE_MEDIA_LAMBDA_ARN>",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "ParallelAnalysis"
    },
    "ParallelAnalysis": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "TranscribeAudio",
          "States": {
            "TranscribeAudio": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "<TRANSCRIBE_AUDIO_LAMBDA_ARN>",
                "Payload.$": "$"
              },
              "OutputPath": "$.Payload",
              "Next": "ModerateText"
            },
            "ModerateText": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "<MODERATE_TEXT_LAMBDA_ARN>",
                "Payload.$": "$"
              },
              "OutputPath": "$.Payload",
              "End": true
            }
          }
        },
        {
          "StartAt": "ModerateVisual",
          "States": {
            "ModerateVisual": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "<MODERATE_VISUAL_LAMBDA_ARN>",
                "Payload.$": "$"
              },
              "OutputPath": "$.Payload",
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallel_results",
      "Next": "MergeParallelResults"
    },
    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "job_id.$": "$.job_id",
        "campaign_id.$": "$.campaign_id",
        "source.$": "$.source",
        "artifacts": {
          "ingestion_s3_uri.$": "$.parallel_results[0].artifacts.ingestion_s3_uri",
          "transcript_s3_uri.$": "$.parallel_results[0].artifacts.transcript_s3_uri",
          "text_s3_uri.$": "$.parallel_results[0].artifacts.text_s3_uri",
          "visual_s3_uri.$": "$.parallel_results[1].artifacts.visual_s3_uri"
        },
        "transcript_text.$": "$.parallel_results[0].transcript_text",
        "text_moderation.$": "$.parallel_results[0].text_moderation",
        "visual_moderation.$": "$.parallel_results[1].visual_moderation"
      },
      "Next": "AggregateScores"
    },
    "AggregateScores": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<AGGREGATE_SCORES_LAMBDA_ARN>",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "GenerateSummaryAndPersist"
    },
    "GenerateSummaryAndPersist": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<GENERATE_SUMMARY_AND_PERSIST_LAMBDA_ARN>",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "MarkCompleted"
    },
    "MarkCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<MARK_COMPLETED_LAMBDA_ARN>",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "End": true
    }
  }
}
